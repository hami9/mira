# =============================================================================
# میرا — نمونه متغیرهای محیطی
# این فایل رو کپی کن به .env و مقادیر واقعی رو جایگزین کن.
# هیچ‌وقت فایل .env واقعی رو commit نکن (در .gitignore هست).
# =============================================================================

# --- عمومی ---
NODE_ENV=development
# پورتی که API (NestJS) روش بالا می‌آد
API_PORT=3000
# آدرس عمومی API که ویجت/داشبورد/وردپرس باهاش صحبت می‌کنن
PUBLIC_API_URL=http://localhost:3000
# آدرس داشبورد اپراتور (برای تنظیم CORS)
DASHBOARD_URL=http://localhost:5173
# دامنه‌هایی که اجازه دارن به API وصل شن، جدا شده با کاما (به‌جای *)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL (+ pgvector برای embedding پایگاه دانش) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kgchat
POSTGRES_USER=kgchat
POSTGRES_PASSWORD=change_me_postgres_password
# رشته اتصال کامل که ORM ازش استفاده می‌کنه
DATABASE_URL=postgresql://kgchat:change_me_postgres_password@postgres:5432/kgchat

# --- Redis (presence آنلاین/آفلاین، صف BullMQ، pub-sub بین سرورها) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO / S3-compatible (ذخیره پیوست‌ها با لینک امضادار) ---
# در production می‌تونی این‌ها رو به هر سرویس S3-compatible دیگه (مثل یک ابر ایرانی) تغییر بدی
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mira-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_minio_secret
S3_FORCE_PATH_STYLE=true
# فقط برای بالا آمدن کانتینر minio در dev لازمه
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_secret

# --- JWT احراز هویت اپراتور ---
# سکرت‌ها باید رشته‌های تصادفی بلند و امن باشن (مثلاً با openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_jwt_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- توکن بازدیدکننده ویجت (کوتاه‌عمر، مقید به دامنه ثبت‌شده widget key) ---
WIDGET_TOKEN_SECRET=change_me_widget_token_secret
WIDGET_TOKEN_EXPIRES_IN=1h

# --- هوش مصنوعی (لایه انتزاعی AiProvider — فاز ۴، فقط توسط apps/worker استفاده می‌شه) ---
# مقدار مجاز برای چت: openai | anthropic — embedding همیشه از طریق کلاینت سازگار با OpenAI انجام می‌شه
AI_PROVIDER=openai
# OPENAI_* هم برای OpenAI واقعی کار می‌کنه، هم برای هر endpoint سازگار با OpenAI (مثلاً Gemini):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# مدل embedding برای پایگاه دانش — با Gemini مقدار gemini-embedding-001 استفاده کن
# (بعد پیش‌فرضش ۳۰۷۲ است؛ worker با پارامتر dimensions آن را به ۷۶۸ برش می‌دهد، مطابق ستون pgvector)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# حداکثر توکن مصرفی هر مکالمه (کنترل هزینه AI)
AI_MAX_TOKENS_PER_CONVERSATION=20000

# --- افزونه وردپرس/ووکامرس (فاز ۳) ---
# کلید API که میرا برای صدا زدن REST endpoint سفارشی وردپرس استفاده می‌کنه (سرور-به-سرور)
WORDPRESS_API_KEY=change_me_wordpress_api_key

# --- صف پس‌زمینه BullMQ ---
# پیشوند نام صف‌ها روی Redis، برای جداسازی از سایر پروژه‌های احتمالی روی همان Redis
QUEUE_PREFIX=mira

# =============================================================================
# --- فقط برای استقرار پروداکشن (فاز ۷) ---
# این‌ها را همراه با docker-compose.prod.yml استفاده کن:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# Caddy با همین دامنه‌ها به‌صورت خودکار گواهی SSL می‌گیرد.
# =============================================================================
# دامنه‌ی API و ویجت (همان مقداری که در PUBLIC_API_URL هم می‌گذاری)
APP_DOMAIN=chat.example.com
# دامنه‌ی داشبورد اپراتور — جدا از دامنه‌ی ویجت
DASHBOARD_DOMAIN=panel.example.com
# ایمیل برای ثبت‌نام Let's Encrypt (هشدار انقضای گواهی به این آدرس می‌آید)
ACME_EMAIL=admin@example.com

# --- حساب ادمین اولیه (seed) ---
# در NODE_ENV=production ست‌کردن SEED_ADMIN_PASSWORD اجباری است، وگرنه seed متوقف می‌شود
# تا هیچ استقراری با رمز پیش‌فرضِ معلوم بالا نیاید. رمز هیچ‌وقت در لاگ چاپ نمی‌شود.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=مدیر سیستم
SEED_ADMIN_PASSWORD=
SEED_SITE_NAME=فروشگاه من
SEED_WIDGET_KEY=change_me_widget_key
# دامنه‌هایی که ویجت از آن‌ها مجاز است (جدا با کاما) — همان دامنه‌ی سایت ووکامرس شما
SEED_ALLOWED_DOMAINS=https://shop.example.com
