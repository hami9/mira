# =============================================================================
# Mira — example environment variables
# Copy this file to .env and replace the values with real ones.
# Never commit a real .env file (it is gitignored).
# =============================================================================

# --- General ---
NODE_ENV=development
# The port the API (NestJS) listens on
API_PORT=3000
# The public API address the widget/dashboard/WordPress talk to
PUBLIC_API_URL=http://localhost:3000
# The operator dashboard address (used for CORS)
DASHBOARD_URL=http://localhost:5173
# Comma-separated list of origins allowed to reach the API (instead of *)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL (+ pgvector for knowledge base embeddings) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kgchat
POSTGRES_USER=kgchat
POSTGRES_PASSWORD=change_me_postgres_password
# The full connection string used by the ORM
DATABASE_URL=postgresql://kgchat:change_me_postgres_password@postgres:5432/kgchat

# --- Redis (online/offline presence, the BullMQ queue, pub/sub between servers) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO / S3-compatible (attachment storage with signed links) ---
# In production you can point these at any other S3-compatible service
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mira-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_minio_secret
S3_FORCE_PATH_STYLE=true
# Only needed to bring up the minio container in development
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_secret

# --- Operator authentication JWT ---
# The secrets must be long, secure random strings (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_jwt_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Widget visitor token (short-lived, bound to the widget key's registered domain) ---
WIDGET_TOKEN_SECRET=change_me_widget_token_secret
WIDGET_TOKEN_EXPIRES_IN=1h

# --- AI (the AiProvider abstraction — phase 4, used only by apps/worker) ---
# Allowed values for chat: openai | anthropic — embeddings always go through the OpenAI-compatible client
AI_PROVIDER=openai
# OPENAI_* works both with real OpenAI and with any OpenAI-compatible endpoint (e.g. Gemini):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# The knowledge base embedding model — with Gemini use gemini-embedding-001
# (its default dimension is 3072; the worker truncates it to 768 with the dimensions
#  parameter, matching the pgvector column)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Maximum tokens per conversation (AI cost control)
AI_MAX_TOKENS_PER_CONVERSATION=20000

# --- WordPress/WooCommerce plugin (phase 3) ---
# The API key Mira uses to call the plugin's custom WordPress REST endpoint (server to server)
WORDPRESS_API_KEY=change_me_wordpress_api_key

# --- BullMQ background queue ---
# Queue name prefix on Redis, to keep it separate from other projects sharing the same Redis
QUEUE_PREFIX=mira

# =============================================================================
# --- Production deployment only (phase 7) ---
# Use these together with docker-compose.prod.yml:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# Caddy obtains SSL certificates for these domains automatically.
# =============================================================================
# The API and widget domain (the same value you put in PUBLIC_API_URL)
APP_DOMAIN=chat.example.com
# The operator dashboard domain — separate from the widget domain
DASHBOARD_DOMAIN=panel.example.com
# Email for Let's Encrypt registration (expiry warnings go to this address)
ACME_EMAIL=admin@example.com

# --- Initial admin account (seed) ---
# Under NODE_ENV=production, SEED_ADMIN_PASSWORD is mandatory — otherwise the seed stops,
# so no deployment ever comes up with a known default password. The password is never logged.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=مدیر سیستم
SEED_ADMIN_PASSWORD=
SEED_SITE_NAME=فروشگاه من
SEED_WIDGET_KEY=change_me_widget_key
# Comma-separated origins the widget is allowed on — your WooCommerce site's domain
SEED_ALLOWED_DOMAINS=https://shop.example.com
