# Dockerfile پروداکشن داشبورد — build استاتیک Vite + سروِ nginx
# (Dockerfile اصلی برای توسعه است و dev server اجرا می‌کند؛ این یکی فقط در
#  docker-compose.prod.yml استفاده می‌شود.)
# context ریشه‌ی مونوریپوست.
FROM node:20-alpine AS builder
WORKDIR /repo

# فقط package.jsonها اول کپی می‌شوند تا لایه‌ی npm install کش شود
COPY package.json package-lock.json* ./
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY apps/widget/package.json apps/widget/package.json
RUN npm install

COPY . .

# آدرس عمومی API در زمان build داخل باندل استاتیک می‌نشیند (Vite env زمان اجرا ندارد)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build -w packages/shared-types && npm run build -w apps/dashboard

FROM nginx:1.27-alpine
COPY apps/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/apps/dashboard/dist /usr/share/nginx/html
EXPOSE 80
