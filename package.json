{
  "name": "mira",
  "version": "1.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/hami9/mira.git"
  },
  "homepage": "https://github.com/hami9/mira",
  "bugs": {
    "url": "https://github.com/hami9/mira/issues"
  },
  "description": "Self-hosted AI-powered live chat support platform for WordPress/WooCommerce",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w packages/shared-types && npm run build -w apps/api && npm run build -w apps/worker && npm run build -w apps/widget && npm run build -w apps/dashboard",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest tests/unit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.62.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "pg": "^8.22.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.9"
  }
}
