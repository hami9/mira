#!/usr/bin/env bash
# ابزار خط فرمان میرا — مدیریت نصب و اجرای پلتفرم چت پشتیبانی میرا روی سرور لینوکس
# نصب‌شده توسط پکیج mira (یا install.sh). راهنمای کامل: /usr/share/doc/mira/INSTALL.md
# خروجی این ابزار انگلیسی است (عرف ابزارهای خط فرمان دبیان)؛ راهنمای فارسی: INSTALL.fa.md
set -euo pipefail

APP_DIR="/opt/mira/app"
ETC_DIR="/etc/mira"
ENV_FILE="$ETC_DIR/mira.env"
COMPOSE_FILES_FILE="$ETC_DIR/compose-files"

# رنگ‌ها فقط وقتی خروجی ترمینال است
if [ -t 1 ]; then
  C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'; C_BOLD=$'\033[1m'; C_OFF=$'\033[0m'
else
  C_GREEN=''; C_RED=''; C_YELLOW=''; C_BOLD=''; C_OFF=''
fi

ok()   { echo "${C_GREEN}✔${C_OFF} $*"; }
warn() { echo "${C_YELLOW}!${C_OFF} $*"; }
err()  { echo "${C_RED}✘${C_OFF} $*" >&2; }
die()  { err "$*"; exit 1; }

need_root() {
  [ "$(id -u)" = "0" ] || die "This command requires root — run it with sudo: sudo mira ${1:-}"
}

compose_files() {
  if [ -f "$COMPOSE_FILES_FILE" ]; then
    cat "$COMPOSE_FILES_FILE"
  else
    echo "-f docker-compose.yml -f docker-compose.prod.yml"
  fi
}

compose() {
  # shellcheck disable=SC2046
  (cd "$APP_DIR" && docker compose $(compose_files) "$@")
}

have_docker() {
  command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1
}

# آیا نصب روی حالت «ایمیج آماده از GHCR» تنظیم شده؟ (به‌جای build از سورس)
uses_ghcr() {
  [ -f "$COMPOSE_FILES_FILE" ] && grep -q 'ghcr' "$COMPOSE_FILES_FILE"
}

rand_hex() { openssl rand -hex 32; }
rand_pass() { openssl rand -base64 18 | tr -d '/+=' | cut -c1-16; }

ask() {
  # ask "question" "default"
  local prompt="$1" default="${2:-}" answer
  if [ -n "$default" ]; then
    read -r -p "$prompt [$default]: " answer
    echo "${answer:-$default}"
  else
    while true; do
      read -r -p "$prompt: " answer
      [ -n "$answer" ] && { echo "$answer"; return; }
      warn "This value is required."
    done
  fi
}

install_docker_prompt() {
  warn "Docker is not installed on this server (or the compose plugin is missing)."
  read -r -p "Install it now using the official get.docker.com script? (y/n) " yn
  case "$yn" in
    y|Y)
      curl -fsSL https://get.docker.com | sh
      systemctl enable --now docker
      ok "Docker installed and enabled."
      ;;
    *)
      die "Cannot continue without Docker. Once it is installed, run 'sudo mira setup' again."
      ;;
  esac
}

cmd_setup() {
  need_root setup
  [ -d "$APP_DIR" ] || die "Directory $APP_DIR not found — install the mira package first."
  command -v openssl >/dev/null 2>&1 || die "openssl is required (apt install openssl)."

  have_docker || install_docker_prompt

  local mode="production"
  if [ "${1:-}" = "--local" ]; then mode="local"; fi

  echo
  echo "${C_BOLD}Mira setup — mode: $mode${C_OFF}"
  echo "Answer each question (a value in [] is the default)."
  echo

  local app_domain="" dashboard_domain="" acme_email="" public_api_url="" cors_origins=""
  local node_env="production"

  if [ "$mode" = "production" ]; then
    echo "— two DNS A records must already point at this server's IP —"
    app_domain=$(ask "Domain for the API and widget (e.g. chat.example.com)")
    dashboard_domain=$(ask "Domain for the operator dashboard (e.g. panel.example.com)")
    acme_email=$(ask "Email for the SSL certificate (Let's Encrypt)")
    public_api_url="https://$app_domain"
    cors_origins="https://$dashboard_domain"

    # منبع ایمیج‌های Docker: build از سورس (پیش‌فرض) یا ایمیج آماده از GHCR
    echo
    echo "Docker image source:"
    echo "  1) Build from source on this server (default — no dependency on ghcr.io)"
    echo "  2) Prebuilt images from GHCR (much faster; requires access to ghcr.io)"
    read -r -p "Choice (1/2) [1]: " image_source
    if [ "${image_source:-1}" = "2" ]; then
      echo "-f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.ghcr.yml" > "$COMPOSE_FILES_FILE.tmp"
    else
      echo "-f docker-compose.yml -f docker-compose.prod.yml" > "$COMPOSE_FILES_FILE.tmp"
    fi
  else
    # حالت local: بدون Caddy/SSL — برای تست روی شبکه‌ی داخلی
    app_domain="chat.example.com"
    dashboard_domain="panel.example.com"
    acme_email="admin@example.com"
    public_api_url="http://localhost:3000"
    cors_origins="http://localhost:5173"
    node_env="development"
    echo "-f docker-compose.yml" > "$COMPOSE_FILES_FILE.tmp"
  fi

  local admin_email admin_name site_name widget_domains
  admin_email=$(ask "Email for the dashboard admin account")
  admin_name=$(ask "Admin name" "Administrator")
  site_name=$(ask "Site/shop name" "My Shop")
  if [ "$mode" = "production" ]; then
    widget_domains=$(ask "Domain(s) where the widget will be installed (comma separated)" "https://shop.example.com")
  else
    widget_domains="http://localhost:3000"
  fi

  echo
  echo "Generating secure random passwords and keys..."
  local pg_pass jwt_access jwt_refresh widget_secret s3_secret wp_api_key widget_key admin_pass
  pg_pass=$(rand_hex)
  jwt_access=$(rand_hex)
  jwt_refresh=$(rand_hex)
  widget_secret=$(rand_hex)
  s3_secret=$(rand_hex)
  wp_api_key=$(rand_hex)
  widget_key=$(openssl rand -hex 16)
  admin_pass=$(rand_pass)

  mkdir -p "$ETC_DIR"
  # فایل env — تنها منبع حقیقت تنظیمات؛ compose هم interpolation و هم env_file را از همین می‌خواند
  cat > "$ENV_FILE.tmp" <<EOF
# Mira configuration — generated by 'mira setup' at $(date -u +%Y-%m-%dT%H:%M:%SZ)
# This file contains secrets; root access only (chmod 600).
# After editing it by hand, run 'sudo mira restart'.

# ---------- General ----------
NODE_ENV=$node_env
API_PORT=3000
PUBLIC_API_URL=$public_api_url
DASHBOARD_URL=https://$dashboard_domain
CORS_ALLOWED_ORIGINS=$cors_origins

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kgchat
POSTGRES_USER=kgchat
POSTGRES_PASSWORD=$pg_pass
DATABASE_URL=postgresql://kgchat:$pg_pass@postgres:5432/kgchat

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- MinIO / S3 ----------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mira-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=$s3_secret
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=$s3_secret

# ---------- JWT ----------
JWT_ACCESS_SECRET=$jwt_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=$jwt_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Widget token ----------
WIDGET_TOKEN_SECRET=$widget_secret
WIDGET_TOKEN_EXPIRES_IN=1h

# ---------- AI (configure this later) ----------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_MAX_TOKENS_PER_CONVERSATION=20000

# ---------- WordPress plugin ----------
WORDPRESS_API_KEY=$wp_api_key

# ---------- Queue ----------
QUEUE_PREFIX=mira

# ---------- Production (Caddy/SSL) ----------
APP_DOMAIN=$app_domain
DASHBOARD_DOMAIN=$dashboard_domain
ACME_EMAIL=$acme_email

# ---------- Initial admin account (seed — only takes effect the first time) ----------
SEED_ADMIN_EMAIL=$admin_email
SEED_ADMIN_NAME=$admin_name
SEED_ADMIN_PASSWORD=$admin_pass
SEED_SITE_NAME=$site_name
SEED_WIDGET_KEY=$widget_key
SEED_ALLOWED_DOMAINS=$widget_domains
EOF

  mv "$ENV_FILE.tmp" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  mv "$COMPOSE_FILES_FILE.tmp" "$COMPOSE_FILES_FILE"
  ln -sfn "$ENV_FILE" "$APP_DIR/.env"
  mkdir -p "$APP_DIR/backups"

  systemctl daemon-reload 2>/dev/null || true

  echo
  ok "Configuration saved to $ENV_FILE"
  echo
  echo "${C_BOLD}================= Admin credentials =================${C_OFF}"
  echo "  Dashboard URL:    ${C_BOLD}https://$dashboard_domain${C_OFF}"
  echo "  Email:            ${C_BOLD}$admin_email${C_OFF}"
  echo "  Password:         ${C_BOLD}$admin_pass${C_OFF}"
  echo "  Widget key:       ${C_BOLD}$widget_key${C_OFF}"
  echo "  WordPress API key: ${C_BOLD}$wp_api_key${C_OFF}"
  echo "${C_BOLD}=====================================================${C_OFF}"
  warn "Save these somewhere safe right now — the password is never displayed again."
  echo
  echo "Next step:  ${C_BOLD}sudo mira start${C_OFF}   (the first run takes a few minutes — images are built)"
}

cmd_start() {
  need_root start
  [ -f "$ENV_FILE" ] || die "Not set up yet — run 'sudo mira setup' first."
  have_docker || die "Docker is not available."
  if uses_ghcr; then
    echo "Pulling prebuilt images from GHCR and starting the services..."
    compose pull
    compose up -d --no-build
  else
    echo "Building images and starting the services (the first run takes a few minutes)..."
    compose up -d --build
  fi
  systemctl enable mira >/dev/null 2>&1 || true
  ok "Mira is up. Check it with 'mira status'."
}

cmd_stop() {
  need_root stop
  compose stop
  ok "Services stopped."
}

cmd_restart() {
  need_root restart
  compose up -d
  ok "Services restarted."
}

cmd_status() {
  [ -f "$ENV_FILE" ] || die "Not set up yet — run 'sudo mira setup'."
  compose ps
  echo
  # سلامت API از داخل شبکه‌ی داکر (پورت api در پروداکشن روی هاست باز نیست)
  if compose exec -T api wget -qO- http://127.0.0.1:3000/health >/dev/null 2>&1; then
    ok "API is healthy (/health responded)."
  else
    warn "API is not responding yet — if you just started it, wait a moment; otherwise check 'mira logs api'."
  fi
}

cmd_logs() {
  compose logs --tail 100 -f "${1:-}"
}

cmd_update() {
  need_root update
  echo "To get a new version, download the package from GitHub Releases and install it:"
  echo "  sudo dpkg -i mira_<version>_all.deb"
  echo "This command then rebuilds the images and updates the services"
  echo "(database migrations run automatically, with no data loss):"
  read -r -p "Run the update now? (y/n) " yn
  case "$yn" in
    y|Y)
      if uses_ghcr; then
        # حالت ایمیج آماده: فقط تگ جدید pull می‌شود، build ای در کار نیست
        compose pull
        compose up -d --no-build
      else
        compose build --pull
        compose up -d
      fi
      ok "Update complete."
      ;;
    *) echo "Cancelled." ;;
  esac
}

cmd_backup() {
  need_root backup
  [ -f "$ENV_FILE" ] || die "Not set up yet."
  local out="$APP_DIR/backups/mira-manual-$(date -u +%Y%m%d-%H%M%S).sql.gz"
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  docker exec mira_postgres pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB" | gzip > "$out"
  ok "Backup created: $out"
}

cmd_restore() {
  need_root restore
  local file="${1:-}"
  [ -n "$file" ] || die "Give the path to a backup file: sudo mira restore /opt/mira/app/backups/mira-....sql.gz"
  [ -f "$file" ] || die "File not found: $file"
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  warn "Restoring overwrites the current data."
  read -r -p "Continue? (y/n) " yn
  case "$yn" in
    y|Y)
      gunzip -c "$file" | docker exec -i mira_postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"
      ok "Restore complete."
      ;;
    *) echo "Cancelled." ;;
  esac
}

cmd_doctor() {
  echo "${C_BOLD}Mira installation health check${C_OFF}"
  echo

  if have_docker; then
    ok "Docker + Compose: $(docker compose version --short 2>/dev/null || echo '?')"
  else
    err "Docker or the compose plugin is not available."
  fi

  if [ -d "$APP_DIR" ]; then ok "Application directory: $APP_DIR"; else err "Directory $APP_DIR does not exist."; fi

  if [ -f "$ENV_FILE" ]; then
    ok "Configuration file: $ENV_FILE"
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    if [ -z "${SEED_ADMIN_PASSWORD:-}" ] && [ "${NODE_ENV:-}" = "production" ]; then
      err "SEED_ADMIN_PASSWORD is empty — in production this puts the api in a restart loop. Run 'mira setup' again."
    fi
    for d in "${APP_DOMAIN:-}" "${DASHBOARD_DOMAIN:-}"; do
      if [ -n "$d" ] && [ "$d" != "chat.example.com" ] && [ "$d" != "panel.example.com" ]; then
        if getent hosts "$d" >/dev/null 2>&1; then
          ok "DNS for $d resolves."
        else
          warn "DNS for $d did not resolve — check the A record."
        fi
      fi
    done
  else
    warn "No configuration file — run 'sudo mira setup'."
  fi

  if [ -L "$APP_DIR/.env" ] || [ -f "$APP_DIR/.env" ]; then
    ok ".env link inside the application directory is in place."
  else
    warn "No .env in $APP_DIR (it is created by setup)."
  fi

  if have_docker && docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^mira_api$'; then
    if docker exec mira_api wget -qO- http://127.0.0.1:3000/health >/dev/null 2>&1; then
      ok "The api container is running and healthy."
    else
      warn "The api container is up but /health did not respond — check 'mira logs api'."
    fi
  else
    warn "The api container is not running."
  fi
}

cmd_help() {
  cat <<'EOF'
mira — server management tool for the Mira live chat platform
Usage: mira <command>

Commands:
  setup [--local]   First-time setup: generate configuration and secure secrets
                    (production or local mode)
  start             Build the images, start every service, enable start on boot
  stop              Stop the services
  restart           Apply configuration changes and bring the services back up
  status            Container status and API health
  logs [service]    Follow the live log (api, worker, dashboard, postgres, caddy, ...)
  update            Rebuild the images after installing a new version of the package
  backup            Immediate database backup into /opt/mira/app/backups
  restore <file>    Restore the database from a backup file
  doctor            Diagnostics: Docker, DNS, configuration, service health
  help              This help

Full installation guide: /usr/share/doc/mira/INSTALL.md (Persian: INSTALL.fa.md)
Complete removal: sudo systemctl stop mira && sudo apt remove mira
EOF
}

case "${1:-help}" in
  setup)   shift; cmd_setup "$@" ;;
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  logs)    shift || true; cmd_logs "${1:-}" ;;
  update)  cmd_update ;;
  backup)  cmd_backup ;;
  restore) shift || true; cmd_restore "${1:-}" ;;
  doctor)  cmd_doctor ;;
  help|--help|-h) cmd_help ;;
  *) err "Unknown command: $1"; cmd_help; exit 1 ;;
esac
