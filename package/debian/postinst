#!/bin/sh
# بعد از نصب پکیج mira
set -e

case "$1" in
  configure)
    systemctl daemon-reload >/dev/null 2>&1 || true

    # اگر نصب قبلاً راه‌اندازی شده (ارتقا)، پیوند .env را دوباره برقرار کن
    if [ -f /etc/mira/mira.env ]; then
      ln -sfn /etc/mira/mira.env /opt/mira/app/.env
      mkdir -p /opt/mira/app/backups
      echo "Mira updated. To apply the new version: sudo mira update"
    else
      echo ""
      echo "Mira installed ✔"
      echo "Next step (first-time setup and secure secret generation):"
      echo "    sudo mira setup"
      echo "Full guide: /usr/share/doc/mira/INSTALL.md (Persian: INSTALL.fa.md)"
      echo ""
    fi
    ;;
esac

exit 0
