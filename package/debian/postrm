#!/bin/sh
# بعد از حذف پکیج mira
set -e

case "$1" in
  purge)
    # purge فقط تنظیمات را پاک می‌کند؛ داده‌های دیتابیس در volumeهای داکر می‌مانند
    # (حذف کامل داده‌ها: docker compose down -v — عمداً خودکار انجام نمی‌شود)
    rm -rf /etc/mira
    rm -f /opt/mira/app/.env
    echo "تنظیمات میرا پاک شد. داده‌های دیتابیس در volumeهای داکر باقی است؛"
    echo "برای حذف کامل: docker volume ls | grep mira"
    ;;
esac

systemctl daemon-reload >/dev/null 2>&1 || true

exit 0
